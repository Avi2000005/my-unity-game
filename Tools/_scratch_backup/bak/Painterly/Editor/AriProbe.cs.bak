    public static class AriProbe
    {
    	private const string Dir = "Assets/Art/Ari/Models";

    	[MenuItem("Tools/Echoes/Probe Ari", priority = 90)]
    	public static void Run()
    	{
    		StringBuilder stringBuilder = new StringBuilder();
    		ProbeAvatar(stringBuilder);
    		ProbeClips(stringBuilder, "Ari_character");
    		ProbeClips(stringBuilder, "Idle");
    		ProbeClips(stringBuilder, "Walking");
    		ProbeMeshes(stringBuilder, "Ari_character");
    		File.WriteAllText("Temp/ari_probe.txt", stringBuilder.ToString());
    		Debug.Log((object)("[Echoes] Ari probe -> Temp/ari_probe.txt\n" + stringBuilder));
    	}

    	private static void ProbeAvatar(StringBuilder sb)
    	{
