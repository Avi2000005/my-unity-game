    		{
    			position = val.transform.position;
    			value = "Ari is at " + position.ToString("F2");
    		}
    		else
    		{
    			value = "no Ari in the scene — clearance is measured against village geometry only";
    		}
    		sb.AppendLine(value);
    		sb.AppendLine();
