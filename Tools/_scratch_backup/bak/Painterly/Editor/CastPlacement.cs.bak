    		}
    		Physics.SyncTransforms();
    		GameObject val = GameObject.Find("Ari");
    		float squareGround = GroundHeight((Vector3)(((Object)(object)val != (Object)null) ? val.transform.position : new Vector3(6f, 0f, 6f)), out var _);
    		string text;
    		Vector3 position;
    		if (!((Object)(object)val != (Object)null))
    		{
    			text = "at (6, 0, 6), the fallback, because there is no Ari in the scene";
    		}
    		else
    		{
    			position = val.transform.position;
    			text = "under Ari at " + position.ToString("F2");
    		}
    		string text2 = text;
    		sb.AppendLine("reference ground y = " + squareGround.ToString("F2") + ", measured " + text2 + " (the floor, not the roof or prop above it)");
    		sb.AppendLine("house at (25, 0, -8); fountain at (0.01, 0.05, 0); Ari's capsule is r 0.30 h 1.80, walls ~0, clearance capsule here is r " + 0.4f.ToString("0.00") + " h " + 1.8f.ToString("0.00"));
    		sb.AppendLine();
