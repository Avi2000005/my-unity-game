    		("InkCrawler_Back", "InkCrawler.fbx", "InkCrawler.controller", new Vector3(-8f, 0f, -14f), 8f, 8f, 1.1f, ""),
    		("InkCrawler_AlleyA", "InkCrawler.fbx", "InkCrawler.controller", new Vector3(-2.5f, 0f, 12f), 6f, 5f, 1.1f, "Alley"),
