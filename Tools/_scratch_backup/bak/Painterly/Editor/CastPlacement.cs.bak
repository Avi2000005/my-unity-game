    		int problems = 0;
    		Dictionary<string, Vector3> dictionary = new Dictionary<string, Vector3>();
    		(string, string, string, Vector3, float, float, float, string)[] cast = Cast;
    		for (int i = 0; i < cast.Length; i++)
    		{
    			(string, string, string, Vector3, float, float, float, string) who = cast[i];
    			string text3 = "Assets/Art/L1/" + who.Item2;
    			string text4 = "Assets/Art/L1/" + who.Item3;
    			RuntimeAnimatorController val3 = AssetDatabase.LoadAssetAtPath<RuntimeAnimatorController>(text4);
    			if ((Object)(object)val3 == (Object)null)
    			{
    				sb.AppendLine(who.Item1 + ": NO CONTROLLER at " + text4 + " — skipped");
    				problems++;
    				continue;
    			}
    			Transform val4 = val2.transform.Find(who.Item1);
    			if ((Object)(object)val4 != (Object)null)
    			{
    				Describe(sb, who, val4.position, ((Component)val4).gameObject, "already placed, left alone");
    				if (who.Item8 != "")
    				{
    					dictionary[who.Item8] = val4.position;
    				}
    				placed++;
    				continue;
    			}
    			GameObject val5 = AssetDatabase.LoadAssetAtPath<GameObject>(text3);
    			if ((Object)(object)val5 == (Object)null)
    			{
    				sb.AppendLine(who.Item1 + ": NO MODEL at " + text3 + " — skipped");
    				problems++;
    				continue;
    			}
    			Vector3 wanted = who.Item4;
    			string text5 = "";
    			if (who.Item8 != "" && dictionary.TryGetValue(who.Item8, out var value2))
    			{
    				wanted = value2;
    				text5 = "searched around its group mate at " + value2.ToString("F1");
    			}
    			Vector3? val6 = FindSpot(who, wanted, squareGround, out var why);
    			if (!val6.HasValue)
    			{
    				sb.AppendLine(who.Item1 + ": NO SPOT FOUND near " + wanted.ToString("F1") + ". " + why);
    				problems++;
    				continue;
    			}
    			GameObject val7 = (GameObject)PrefabUtility.InstantiatePrefab((Object)(object)val5, val2.transform);
    			((Object)val7).name = who.Item1;
    			val7.transform.position = val6.Value;
    			val7.transform.rotation = FaceSquare(val6.Value);
    			Animator componentInChildren = val7.GetComponentInChildren<Animator>();
    			if ((Object)(object)componentInChildren == (Object)null)
    			{
    				sb.AppendLine(who.Item1 + ": no Animator on the model at all — it will not move");
    				problems++;
    			}
    			else
    			{
    				componentInChildren.runtimeAnimatorController = val3;
    				componentInChildren.applyRootMotion = false;
    				componentInChildren.updateMode = (AnimatorUpdateMode)0;
    				componentInChildren.cullingMode = (AnimatorCullingMode)0;
    			}
    			EnsureCollider(val7);
    			Physics.SyncTransforms();
    			float num = HeightOf(val7);
    			FitHeight(val7, who.Item7);
    			Physics.SyncTransforms();
    			Describe(sb, who, val7.transform.position, val7, why + text5 + ", scaled from " + num.ToString("0.00") + " m to " + HeightOf(val7).ToString("0.00") + " m tall");
    			if (who.Item8 != "")
    			{
    				dictionary[who.Item8] = val7.transform.position;
    			}
    			placed++;
    		}
    		PlaceThief(sb, val2, squareGround, ref placed, ref problems);
    		sb.AppendLine();
    		sb.AppendLine(placed + " placed, " + problems + " problem(s)");
    		EditorSceneManager.MarkSceneDirty(activeScene);
    		EditorSceneManager.SaveScene(activeScene);
    	}

