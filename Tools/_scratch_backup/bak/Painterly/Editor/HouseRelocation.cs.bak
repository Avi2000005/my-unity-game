    		//IL_005e: Unknown result type (might be due to invalid IL or missing references)
    		int num = Physics.OverlapBoxNonAlloc(box.center, box.extents, buffer, Quaternion.identity, -1, (QueryTriggerInteraction)1);
    		int num2 = 0;
    		for (int i = 0; i < num; i++)
    		{
    			Collider val = buffer[i];
    			if (!((Object)(object)val == (Object)null) && !IsIgnored(((Component)val).transform, ignore))
    			{
    				Bounds bounds = val.bounds;
    				if (!(bounds.max.y <= groundY + 0.35f) && !(bounds.min.y >= topY))
    				{
    					num2++;
    				}
    			}
    		}
    		return num2;
    	}

    	private static float Margin(Vector3 centre, float radius, float groundY, float topY, IList<Transform> ignore, Collider[] buffer)
    	{
    		//IL_0000: Unknown result type (might be due to invalid IL or missing references)
