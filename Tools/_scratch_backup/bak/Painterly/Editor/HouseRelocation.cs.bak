    				if (Mathf.Abs(val.point.y - squareGroundY) > 0.6f)
    				{
    					return false;
    				}
    				Bounds bounds = val.collider.bounds;
    				if (bounds.size.y > 0.7f)
    				{
    					return false;
    				}
    				if (bounds.max.y > squareGroundY + 1.2f)
    				{
    					return false;
    				}
    				groundY = val.point.y;
    				return true;
    			}
    		}
    		return false;
    	}

    	private static int CountObstructions(Bounds box, float groundY, float topY, IList<Transform> ignore, Collider[] buffer)
    	{
    		//IL_0002: Unknown result type (might be due to invalid IL or missing references)
