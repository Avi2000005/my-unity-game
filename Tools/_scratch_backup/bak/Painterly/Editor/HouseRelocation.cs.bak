    	}

    	private static bool IsIgnored(Transform t, IList<Transform> ignore)
    	{
    		if (ignore == null)
    		{
    			return false;
    		}
    		for (int i = 0; i < ignore.Count; i++)
    		{
    			Transform val = ignore[i];
    			if (!((Object)(object)val == (Object)null) && ((Object)(object)t == (Object)(object)val || t.IsChildOf(val)))
    			{
    				return true;
    			}
    		}
    		return false;
    	}

    	private static float Median(SquarePlacement.Scan scan)
    	{
    		if (scan == null || !scan.Ok || scan.Spots.Count == 0)
    		{
    			return 0f;
    		}
    		List<float> list = (from s in scan.Spots
    			select s.Clearance into v
    			orderby v
    			select v).ToList();
    		return list[list.Count / 2];
    	}

    	private static float CentreClearance(SquarePlacement.Scan scan, Vector3 centre)
    	{
    		//IL_0038: Unknown result type (might be due to invalid IL or missing references)
    		//IL_004a: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0051: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0056: Unknown result type (might be due to invalid IL or missing references)
    		//IL_005b: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0060: Unknown result type (might be due to invalid IL or missing references)
    		if (scan == null || !scan.Ok)
    		{
    			return 0f;
    		}
    		float num = 0f;
    		foreach (SquarePlacement.Spot spot in scan.Spots)
    		{
    			if (!(Vector3.Distance(Vector2.op_Implicit(new Vector2(spot.Point.x - centre.x, spot.Point.z - centre.z)), Vector2.op_Implicit(Vector2.zero)) > 2f) && spot.Clearance > num)
    			{
    				num = spot.Clearance;
    			}
    		}
    		return num;
    	}

    	private static void Finish(StringBuilder sb)
    	{
    		Directory.CreateDirectory(Path.GetDirectoryName(Path.Combine(Directory.GetCurrentDirectory(), "Temp/house_relocation.txt")));
    		File.WriteAllText(Path.Combine(Directory.GetCurrentDirectory(), "Temp/house_relocation.txt"), sb.ToString());
    		Debug.Log((object)sb.ToString());
    	}
    }
