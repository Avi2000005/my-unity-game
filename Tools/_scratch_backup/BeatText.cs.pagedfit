    		//IL_002b: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0032: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0038: Unknown result type (might be due to invalid IL or missing references)
    		//IL_003f: Expected Obj, but got Unknown
    		GUIStyle val = new GUIStyle(GUI.skin.label)
    		{
    			alignment = anchor,
    			fontSize = Mathf.Max(10, fontSize),
    			wordWrap = wordWrap,
    			richText = false
    		};
    		val.normal.textColor = colour;
    		return val;
    	}

    	public static GUIStyle MakeStandalone(TextAnchor anchor, int fontSize, bool wordWrap, Color colour)
    	{
    		//IL_0000: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0005: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0006: Unknown result type (might be due to invalid IL or missing references)
    		//IL_000c: Unknown result type (might be due to invalid IL or missing references)
    		//IL_001a: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0021: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0029: Expected Obj, but got Unknown
    		//IL_006c: Unknown result type (might be due to invalid IL or missing references)
    		GUIStyle val = new GUIStyle
    		{
    			alignment = anchor,
    			fontSize = Mathf.Max(10, fontSize),
    			wordWrap = wordWrap,
    			richText = false
    		};
    		if ((Object)(object)val.font == (Object)null)
    		{
    			Font builtinResource = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
    			if ((Object)(object)builtinResource == (Object)null)
    			{
    				builtinResource = Resources.GetBuiltinResource<Font>("Arial.ttf");
    			}
    			if ((Object)(object)builtinResource != (Object)null)
    			{
    				val.font = builtinResource;
    			}
    		}
    		val.normal.textColor = colour;
    		return val;
    	}

    	public static int FitStandalone(string text, float width, float maxHeight, int target, TextAnchor anchor)
    	{
    		//IL_0000: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0004: Unknown result type (might be due to invalid IL or missing references)
    		return Fit(MakeStandalone(anchor, target, wordWrap: true, Ink), text, width, maxHeight, target);
    	}

    	public static List<string> ShortfallsStandalone(IList<string> lines, TextAnchor anchor, float width, float maxHeight, int target)
    	{
    		//IL_0006: Unknown result type (might be due to invalid IL or missing references)
    		//IL_000a: Unknown result type (might be due to invalid IL or missing references)
    		List<string> list = new List<string>();
    		GUIStyle probe = MakeStandalone(anchor, target, wordWrap: true, Ink);
    		for (int i = 0; i < lines.Count; i++)
    		{
    			string text = lines[i];
    			if (!string.IsNullOrEmpty(text))
    			{
    				int num = Fit(probe, text, width, maxHeight, target);
    				if (num < target)
    				{
    					list.Add(Report(i + 1, text, probe, num, target, maxHeight, width));
    				}
    			}
    		}
    		return list;
    	}

    	internal static string Report(int n, string s, GUIStyle probe, int fit, int target, float maxHeight, float width)
    	{
    		//IL_0007: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0013: Expected Obj, but got Unknown
    		float num = Mathf.Max(1f, (float)Mathf.CeilToInt(probe.CalcHeight(new GUIContent(s), width) / Mathf.Max(1f, probe.lineHeight)));
    		return "  " + n + ". " + ((float)s.Length).ToString("0") + " chars, " + num.ToString("0") + " wrapped lines: asked " + target + " px, largest that fits " + maxHeight.ToString("0") + " px of height is " + fit + " px  (" + ((float)fit * 100f / (float)target).ToString("0") + "% of target)";
    	}

    	public static int Fit(GUIStyle probe, string text, float width, float maxHeight, int target)
    	{
    		//IL_008d: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0098: Expected Obj, but got Unknown
    		if (string.IsNullOrEmpty(text) || width <= 1f)
    		{
    			return target;
    		}
    		for (int i = 0; i < _keys.Length; i++)
    		{
    			if (_keys[i].Same(new Key
    			{
    				Text = text,
    				Width = width,
    				MaxHeight = maxHeight,
    				Target = target
    			}))
    			{
    				return _sizes[i];
    			}
    		}
    		int num = 10;
    		int num2 = Mathf.Max(10, target);
    		int num3 = 10;
    		while (num <= num2)
    		{
    			int num4 = (probe.fontSize = (num + num2) / 2);
    			if (probe.CalcHeight(new GUIContent(text), width) <= maxHeight)
    			{
    				num3 = num4;
    				num = num4 + 1;
    			}
    			else
    			{
    				num2 = num4 - 1;
    			}
    		}
    		probe.fontSize = target;
    		_keys[_next] = new Key
    		{
    			Text = text,
    			Width = width,
    			MaxHeight = maxHeight,
    			Target = target
    		};
    		_sizes[_next] = num3;
    		_next = (_next + 1) % _keys.Length;
    		return num3;
    	}

    	public static float Height(GUIStyle style, string text, float width)
    	{
    		//IL_0002: Unknown result type (might be due to invalid IL or missing references)
    		//IL_000d: Expected Obj, but got Unknown
    		return style.CalcHeight(new GUIContent(text), width);
    	}

    	public static GUIStyle Fitted(GUIStyle template, string text, float width, float maxHeight, int target)
    	{
    		//IL_000d: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0012: Unknown result type (might be due to invalid IL or missing references)
    		//IL_001a: Expected Obj, but got Unknown
    		int fontSize = Fit(template, text, width, maxHeight, target);
    		return new GUIStyle(template)
    		{
    			fontSize = fontSize
    		};
    	}

    	public static Rect Block(GUIStyle template, string text, float centreX, float bottomY, float width, float maxHeight, int target, out int usedSize)
    	{
    		//IL_0011: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0016: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0020: Expected Obj, but got Unknown
    		//IL_0022: Unknown result type (might be due to invalid IL or missing references)
    		//IL_002e: Expected Obj, but got Unknown
    		//IL_0041: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0047: Unknown result type (might be due to invalid IL or missing references)
    		//IL_004d: Expected Obj, but got Unknown
    		//IL_0053: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0085: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0091: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0099: Unknown result type (might be due to invalid IL or missing references)
    		usedSize = Fit(template, text, width, maxHeight, target);
    		GUIStyle val = new GUIStyle(template)
    		{
    			fontSize = usedSize
    		};
    		float num = val.CalcHeight(new GUIContent(text), width);
    		Rect val2 = new Rect(centreX - width * 0.5f, bottomY - num, width, num);
    		GUIStyle val3 = new GUIStyle(val);
    		val3.normal.textColor = Shadow;
    		GUI.Label(new Rect(val2.x + 2f, val2.y + 2f, val2.width, val2.height), text, val3);
    		GUI.Label(val2, text, val);
    		return val2;
    	}

    	public static float PromptWidth(float fraction)
    	{
    		return Mathf.Min((float)Screen.width * fraction, (float)Screen.width - 24f);
    	}

    	/// <summary>
    	/// How many wrapped lines fit in <paramref name="maxHeight"/> at exactly
    	/// <paramref name="target"/> pixels.
    	/// </summary>
    	/// <remarks>
    	/// <para>This exists so that a long line can be PAGED rather than shrunk,
    	/// which is the whole of complaint 2.</para>
    	///
    	/// <para><b>Why not just shrink it.</b> Because that is what the project
    	/// was doing, and the complaint is the result. On a 1080 p game view the
    	/// 5x prompt target is 225 px and the block budget is 0.72 of the screen,
    	/// 778 px. Two lines of 225 px text is all that fits, so a Mono line that
    	/// wraps to seven lines was being fitted down to 112 px - 50% of the size
    	/// the player asked for. The complaint was that the text is too small, and
    	/// the answer "it is 5x except where it is not" is not an answer.</para>
    	///
    	/// <para><b>Why the count is measured and not divided.</b> Line height is
    	/// not a linear function of font size on every platform - the built-in font
    	/// rounds ascent and descent independently - so
    	/// <c>maxHeight / (fontSize * 1.2f)</c> is a guess that overstates the
    	/// count on some machines and understates it on others. One real line is
    	/// measured instead, from a string with an ascender and a descender so the
    	/// figure is the tallest a real line can be.</para>
    	/// </remarks>
    	public static int LinesThatFit(GUIStyle probe, float width, float maxHeight, int target)
    	{
    		if (probe == null || width <= 1f || maxHeight <= 1f)
    		{
    			return 1;
    		}

    		probe.fontSize = Mathf.Max(10, target);

    		// "Wjq" - a capital for the ascent, a descender for the descent, a
    		// lowercase body so the width is not degenerate.
    		float oneLine = probe.CalcHeight(new GUIContent("Wjq"), width);
    		if (oneLine <= 0.01f)
    		{
    			return 1;
    		}

    		return Mathf.Max(1, Mathf.FloorToInt(maxHeight / oneLine));
    	}

    	/// <summary>
    	/// Split <paramref name="text"/> into pages that each fit at exactly
    	/// <paramref name="target"/> pixels.
    	/// </summary>
    	/// <returns>
    	/// One entry per page. A single page is returned when the text already
    	/// fits, so callers need no special case and no behaviour changes for the
    	/// short prompts that were never the problem.
    	/// </returns>
    	/// <remarks>
    	/// <para>Wrapping is done here rather than handed to <c>GUIStyle</c>,
    	/// because Unity will only wrap a string it is asked to draw, and the page
    	/// break has to land on a space. Each word is measured against the width
    	/// at the target size and appended until it no longer fits; the words of
    	/// an over-long single word are left alone rather than split, because a
    	/// hyphen mid-word is worse than a line that overruns.</para>
    	///
    	/// <para>Explicit paragraph breaks are preserved: a blank line in the
    	/// source is a blank line on the page and costs a line of the budget,
    	/// because the source text uses <c>\n\n</c> to separate beats and losing
    	/// that would run two paragraphs together.</para>
    	/// </remarks>
    	public static List<string> Pages(GUIStyle probe, string text, float width, float maxHeight, int target)
    	{
    		var pages = new List<string>(1);

    		if (string.IsNullOrEmpty(text) || probe == null || width <= 1f)
    		{
    			pages.Add(text ?? "");
    		}
    		else
    		{
    			probe.fontSize = Mathf.Max(10, target);
    			int perPage = LinesThatFit(probe, width, maxHeight, target);

    			var lines = new List<string>(8);
    			var paragraphs = (text ?? "").Split('\n');

    			for (int p = 0; p < paragraphs.Length; p++)
    			{
    				string para = paragraphs[p].TrimEnd('\r');

    				if (p > 0)
    				{
    					// A paragraph break costs a line whether or not the
    					// previous paragraph ended short.
    					lines.Add("");
    				}

    				if (para.Trim().Length == 0)
    				{
    					continue;
    				}

    				var words = para.Split(' ');
    				var line = new System.Text.StringBuilder(96);

    				for (int w = 0; w < words.Length; w++)
    				{
    					if (words[w].Length == 0)
    					{
    						// A run of spaces collapsed to one at the break.
    						continue;
    					}

    					if (line.Length == 0)
    					{
    						line.Append(words[w]);
    						continue;
    					}

    					string candidate = line + " " + words[w];
    					if (probe.CalcSize(new GUIContent(candidate)).x <= width)
    					{
    						line.Length = 0;
    						line.Append(candidate);
    					}
    					else
    					{
    						lines.Add(line.ToString());
    						line.Length = 0;
    						line.Append(words[w]);
    					}
    				}

    				if (line.Length > 0)
    				{
    					lines.Add(line.ToString());
    				}
    			}

    			if (lines.Count == 0)
    			{
    				pages.Add(text);
    			}
    			else
    			{
    				for (int i = 0; i < lines.Count; i += perPage)
    				{
    					int end = Mathf.Min(lines.Count, i + perPage);
    					var page = new System.Text.StringBuilder(256);
    					for (int k = i; k < end; k++)
    					{
    						if (page.Length > 0)
    						{
    						page.Append('\n');
    						}
    						page.Append(lines[k]);
    					}
    					pages.Add(page.ToString());
    				}
    			}
    		}

    		return pages;
    	}

    	/// <summary>
    	/// Seconds a page stays on screen before the next one appears.
    	/// </summary>
    	/// <remarks>
    	/// 5 s at the 5x prompt size. A 225 px line holds roughly twelve words, so
    	/// a page is about forty characters: long enough to read aloud at a normal
    	/// pace with room to look up, short enough that a player who does not read
    	/// every word is not held for a minute by a paragraph.
    	/// </remarks>
    	public static float PageSeconds = 5f;

    	private static string _pagedKey;

    	private static int _pagedIndex;

    	private static float _pagedAt;

    	/// <summary>
    	/// Which page of <paramref name="text"/> belongs on screen right now.
    	/// </summary>
    	/// <param name="text">The FULL text, not one page of it.</param>
    	/// <param name="pages">The result of <see cref="Pages"/> for that text.</param>
    	/// <remarks>
    	/// <para><b>One page state for the whole project.</b> Two callers page text -
    	/// the beat prompt and Mono's subtitle - and if each kept its own index they
    	/// would drift: a page turn in one would reset the other mid-sentence,
    	/// because both are keyed on <c>Time.time</c> and neither knows about the
    	/// other.</para>
    	///
    	/// <para><b>Pages advance on a clock, not on a key.</b> S is already bound
    	/// to skip, and binding a second key to "next page" would mean the player
    	/// has to learn which of two near-identical inputs does what. A clock keeps
    	/// the existing skip contract exactly as specified and adds nothing to
    	/// learn.</para>
    	///
    	/// <para><b>The last page is a stop, not a loop.</b> Looping back to the
    	/// first page reads as a brand new line arriving, and since a page turn is
    	/// silent there is nothing to tell the player that the message restarted.</para>
    	/// </remarks>
    	public static int PageOf(string text, List<string> pages)
    	{
    		if (pages == null || pages.Count == 0)
    		{
    			return 0;
    		}

    		if (!string.Equals(_pagedKey, text))
    		{
    			_pagedKey = text;
    			_pagedIndex = 0;
    			_pagedAt = Time.time;
    		}
    		else if (pages.Count > 1 && Application.isPlaying)
    		{
    			float hold = Mathf.Max(0.5f, PageSeconds);
    			if (Time.time - _pagedAt >= hold)
    			{
    				if (_pagedIndex < pages.Count - 1)
    				{
    					_pagedIndex++;
    				}
    				// The clock is refreshed either way. On the last page that costs
    				// nothing and it stops a window resize from being read as "the
    				// player has been on this page for a while" and jumping the page.
    				_pagedAt = Time.time;
    			}
    		}

    		if (_pagedIndex >= pages.Count)
    		{
    			_pagedIndex = pages.Count - 1;
    		}
    		if (_pagedIndex < 0)
    		{
    			_pagedIndex = 0;
    		}

    		return _pagedIndex;
    	}

    	/// <summary>
    	/// Forget which page is showing, so the next line starts on its first page.
    	/// </summary>
    	/// <remarks>
    	/// Not strictly needed - a new line is a new key and resets by itself - but
    	/// it means a checkpoint reset cannot leave a half-read line's page index
    	/// lying around if the same text is ever shown twice in a row.
    	/// </remarks>
    	public static void ForgetPages()
    	{
    		_pagedKey = null;
    		_pagedIndex = 0;
    		_pagedAt = 0f;
    	}

    	public static List<string> Shortfalls(IList<string> lines, TextAnchor anchor, float width, float maxHeight, int target)
    	{
    		//IL_000c: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0010: Unknown result type (might be due to invalid IL or missing references)
    		//IL_005b: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0066: Expected Obj, but got Unknown
    		List<string> list = new List<string>(lines.Count);
    		GUIStyle val = Make(anchor, target, wordWrap: true, Ink);
    		for (int i = 0; i < lines.Count; i++)
    		{
    			string text = lines[i];
    			if (!string.IsNullOrEmpty(text))
    			{
    				int num = Fit(val, text, width, maxHeight, target);
    				if (num < target)
    				{
    					float num2 = text.Length;
    					float num3 = Mathf.Max(1f, (float)Mathf.CeilToInt(val.CalcHeight(new GUIContent(text), width) / Mathf.Max(1f, val.lineHeight)));
    					list.Add("  " + (i + 1) + ". " + num2.ToString("0") + " chars, " + num3.ToString("0") + " wrapped lines: asked " + target + " px, largest that fits " + maxHeight.ToString("0") + " px of height is " + num + " px  (" + ((float)num * 100f / (float)target).ToString("0") + "% of target)");
    				}
    			}
    		}
    		return list;
    	}
    }
}