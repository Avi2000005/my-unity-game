    			};
    			float item3 = item5.Item2;
    			array5[2] = item3.ToString("F2").PadRight(12);
    			int num2 = item5.Item3;
    			array5[3] = num2.ToString().PadRight(10);
    			array5[4] = item5.Item4;
    			stringBuilder.AppendLine(string.Concat(array5));
    		}
    		int num9 = list.Count(((Vector3 p, float clearance, int blockers, string nearest) c) => c.blockers == 0);
    		stringBuilder.AppendLine();
    		stringBuilder.AppendLine("spots with ZERO blockers : " + num9 + " of " + list.Count);
    		(Vector3, float, int, string) tuple = list.OrderByDescending(((Vector3 p, float clearance, int blockers, string nearest) c) => c.clearance).First();
    		stringBuilder.AppendLine("best overall             : " + ((object)tuple.Item1/*cast due to constrained. prefix*/).ToString() + "  clearance " + tuple.Item2.ToString("F2") + " m, blockers " + tuple.Item3);
    		Finish(stringBuilder);
