    	private const string Report = "Temp/beat5_setup.txt";

    	public static void Run()
    	{
    		StringBuilder stringBuilder = new StringBuilder();
    		int pass = 0;
    		int fail = 0;
    		int warn = 0;
    		try
    		{
    			if (Application.isPlaying)
    			{
    				stringBuilder.AppendLine("!! refusing to run in play mode — MarkSceneDirty throws here and the build would stop halfway with nothing to show for it. Stop, then run again.");
    				File.WriteAllText("Temp/beat5_setup.txt", stringBuilder.ToString());
    				Debug.LogError((object)"[Echoes] beat5: in play mode");
    				return;
    			}
    			Body(stringBuilder, ref pass, ref fail, ref warn);
    		}
    		catch (Exception ex)
    		{
    			stringBuilder.AppendLine();
    			stringBuilder.AppendLine("THREW: " + ex.GetType().Name + ": " + ex.Message);
    			stringBuilder.AppendLine(ex.StackTrace);
    			fail++;
    		}
    		stringBuilder.AppendLine();
    		stringBuilder.AppendLine("VERDICT " + ((fail == 0) ? "PASS" : "FAIL") + " — " + pass + " passed, " + fail + " failed, " + warn + " warnings");
    		File.WriteAllText(Path.Combine(Directory.GetCurrentDirectory(), "Temp/beat5_setup.txt"), stringBuilder.ToString());
    		Debug.Log((object)("[Echoes] beat5\n" + stringBuilder));
    	}

