    public static class Beat5Setup
    {
    	private struct Wall
    	{
    	public Wall(string name, float x, float z, float sizeX, float sizeZ, float height)
    	{
    	    	this.name = name;
    	    	this.x = x;
    	    	this.z = z;
    	    	this.sizeX = sizeX;
    	    	this.sizeZ = sizeZ;
    	    	this.height = height;
    	}
    		public readonly string name;

    		public readonly float x;

    		public readonly float z;

    		public readonly float sizeX;

    		public readonly float sizeZ;

    		public readonly float height;

    		public Vector3 Extent
    		{
    			get
    			{
    				//IL_0024: Unknown result type (might be due to invalid IL or missing references)
    				return new Vector3(sizeX * 0.5f, height * 0.5f, sizeZ * 0.5f);
    			}
    		}

    		public Vector3 Centre
    		{
    			get
    			{
    				//IL_0018: Unknown result type (might be due to invalid IL or missing references)
    				return new Vector3(x, height * 0.5f, z);
    			}
    		}
    	}

