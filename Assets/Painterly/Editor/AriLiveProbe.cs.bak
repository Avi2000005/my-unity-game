    	private static float ReadSoleOffset(AriMover mover)
    	{
    		//IL_0024: Unknown result type (might be due to invalid IL or missing references)
    		//IL_002a: Expected Obj, but got Unknown
    		//IL_0044: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0049: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0055: Unknown result type (might be due to invalid IL or missing references)
    		//IL_005a: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0087: Unknown result type (might be due to invalid IL or missing references)
    		SkinnedMeshRenderer componentInChildren = ((Component)mover).GetComponentInChildren<SkinnedMeshRenderer>();
    		if ((Object)(object)componentInChildren == (Object)null || (Object)(object)componentInChildren.sharedMesh == (Object)null)
    		{
    			return 0f;
    		}
    		Mesh val = new Mesh();
    		componentInChildren.BakeMesh(val);
    		Vector3[] vertices = val.vertices;
    		float num = float.MaxValue;
    		Matrix4x4 localToWorldMatrix = ((Component)componentInChildren).transform.localToWorldMatrix;
    		for (int i = 0; i < vertices.Length; i++)
    		{
    			float y = localToWorldMatrix.MultiplyPoint3x4(vertices[i]).y;
    			if (y < num)
    			{
    				num = y;
    			}
    		}
    		Object.DestroyImmediate((Object)(object)val);
    		return ((Component)mover).transform.position.y - num;
    	}

    	private static string ClipNow(Animator anim)
    	{
    		//IL_0009: Unknown result type (might be due to invalid IL or missing references)
    		//IL_000e: Unknown result type (might be due to invalid IL or missing references)
    		AnimatorStateInfo info = anim.GetCurrentAnimatorStateInfo(0);
    		var anon = anim.runtimeAnimatorController.animationClips.Select((AnimationClip c) => new
    		{
    			((Object)c).name,
    			c.length
    		}).FirstOrDefault(c => Animator.StringToHash(c.name) == info.shortNameHash);
    		return "clip=" + ((anon == null) ? "?" : anon.name) + " " + $"len={anon?.length ?? 0f:F2}s " + $"t={info.normalizedTime:F2} " + $"transitioning={anim.IsInTransition(0)}";
    	}

