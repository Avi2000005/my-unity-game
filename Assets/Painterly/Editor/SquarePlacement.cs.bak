    		//IL_0213: Unknown result type (might be due to invalid IL or missing references)
    		Scan scan = new Scan
    		{
    			Area = area
    		};
    		Bounds ground = FindGround(area, out var groundY);
    		if (groundY < float.NegativeInfinity || groundY > float.PositiveInfinity)
    		{
    			scan.Why = "no ground surface found in the area";
    			return scan;
    		}
    		scan.Ground = ground;
    		scan.GroundY = groundY;
    		scan.Ok = true;
    		int num = Mathf.CeilToInt(area.size.x / step) + 1;
    		int num2 = Mathf.CeilToInt(area.size.z / step) + 1;
    		float x = area.min.x;
    		float z = area.min.z;
    		Collider[] array = new Collider[8192];
    		RaycastHit val = default;
    		for (int i = 0; i < num; i++)
    		{
    			for (int j = 0; j < num2; j++)
    			{
    				float num3 = x + (float)i * step;
    				float num4 = z + (float)j * step;
    				if (!Physics.Raycast(new Vector3(num3, area.max.y + 120f, num4), Vector3.down, ref val, 500f, -1, (QueryTriggerInteraction)1) || Mathf.Abs(val.point.y - groundY) > 0.8f)
    				{
    					continue;
    				}
    				Bounds bounds = val.collider.bounds;
    				if (bounds.size.y > 0.7f || IsIgnored(((Component)val.collider).transform, ignore))
    				{
    					continue;
    				}
    				scan.Samples++;
    				Vector3 val2 = new Vector3(num3, val.point.y + 0.7f, num4);
    				int num5 = Physics.OverlapSphereNonAlloc(val2, queryRadius, array, -1, (QueryTriggerInteraction)1);
    				float num6 = queryRadius;
    				string nearest = "<none>";
    				int num7 = 0;
    				for (int k = 0; k < num5; k++)
    				{
    					Collider val3 = array[k];
    					if ((Object)(object)val3 == (Object)null || IsIgnored(((Component)val3).transform, ignore))
    					{
    						continue;
    					}
    					Bounds bounds2 = val3.bounds;
    					if (!(bounds2.max.y <= val.point.y + 0.35f) && !(bounds2.min.y > val.point.y + 1.6f))
    					{
    						num7++;
    						float num8 = Vector3.Distance(val2, bounds2.ClosestPoint(val2));
    						if (num8 < num6)
    						{
    							num6 = num8;
    							nearest = PathOf(((Component)val3).transform);
    						}
    					}
    				}
    				Spot spot = new Spot
    				{
    					Point = new Vector3(num3, val.point.y, num4),
    					Clearance = ((num7 == 0) ? queryRadius : num6),
    					Blockers = num7,
    					Nearest = nearest
    				};
    				scan.Spots.Add(spot);
    				if (scan.Best == null || spot.Clearance > scan.Best.Clearance)
    				{
    					scan.Best = spot;
    				}
    			}
    		}
    		if (scan.Spots.Count == 0)
    		{
    			scan.Why = "no sample landed on ground";
    		}
    		scan.Ok = scan.Spots.Count > 0;
    		return scan;
    	}

    	public static Scan MeasureSquare(float step = 0.4f, float queryRadius = 9f)
    	{
    		//IL_0021: Unknown result type (might be due to invalid IL or missing references)
    		//IL_002e: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0033: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0036: Unknown result type (might be due to invalid IL or missing references)
    		//IL_003b: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0058: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0059: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0066: Unknown result type (might be due to invalid IL or missing references)
    		GameObject val = FindSquare();
    		if ((Object)(object)val == (Object)null)
    		{
    			return new Scan
    			{
    				Why = "no MarketSquare in the scene"
    			};
    		}
    		Bounds val2 = FindGround(TopBounds(val), out var _, val.transform);
    		if (val2.size == Vector3.zero)
    		{
    			return new Scan
    			{
    				Why = "MarketSquare has no low flat ground pieces"
    			};
    		}
    		Bounds area = val2;
    		area.Expand(-0.01f);
    		return Measure(area, step, queryRadius, PlacementIgnores());
    	}

