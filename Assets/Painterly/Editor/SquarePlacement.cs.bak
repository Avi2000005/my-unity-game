    	}

    	public sealed class Scan
    	{
    		public bool Ok;

    		public string Why;

    		public Bounds Area;

    		public Bounds Ground;

    		public float GroundY;

    		public int Tiles;

    		public int Samples;

    		public List<Spot> Spots = new List<Spot>();

    		public Spot Best;

    		public float BestClearance
    		{
    			get
    			{
    				if (Best != null)
    				{
    					return Best.Clearance;
    				}
    				return 0f;
    			}
    		}

    		public IEnumerable<Spot> Fitting(float radius)
    		{
    			return Spots.Where((Spot s) => s.Clearance >= radius);
    		}
    	}

