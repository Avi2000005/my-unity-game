    	private static Color[] Skin(int size)
    	{
    		//IL_00d5: Unknown result type (might be due to invalid IL or missing references)
    		//IL_00da: Unknown result type (might be due to invalid IL or missing references)
    		Color[] array = new Color[size * size];
    		for (int i = 0; i < size; i++)
    		{
    			for (int j = 0; j < size; j++)
    			{
    				float num = (float)j / (float)size;
    				float num2 = 1f - (float)i / (float)size;
    				float num3 = Fbm(num * 5f, num2 * 5f, 4);
    				float num4 = Fbm(num * 19f, num2 * 19f, 3);
    				float num5 = Drips(num, num2);
    				float num6 = 0.055f + num3 * 0.13f + num4 * 0.035f;
    				num6 -= num5 * 0.045f;
    				num6 += Mathf.Pow(Mathf.Max(0f, num3 - 0.55f), 2f) * 0.1f;
    				num6 = Mathf.Clamp01(num6);
    				array[i * size + j] = new Color(num6 * 1f, num6 * 0.975f, num6 * 1.02f, 1f);
    			}
    		}
    		return array;
    	}

    	private static float Drips(float u, float v)
    	{
    		float num = u * 14f;
    		int num2 = Mathf.FloorToInt(num);
    		float num3 = num - (float)num2;
    		float num4 = 0f;
    		for (int i = -1; i <= 1; i++)
    		{
    			int a = num2 + i;
    			if (Hash01(a, 17) < 0.66f)
    			{
    				continue;
    			}
    			float num5 = Hash01(a, 91);
    			if (num3 < num5 || num3 > num5 + 0.34f)
    			{
    				continue;
    			}
    			float num6 = Hash01(a, 43);
    			float num7 = num6 + 0.12f + Hash01(a, 67) * 0.34f;
    			if (!(v > num6) && !(v < num7))
    			{
    				float num8 = (num6 - v) / Mathf.Max(0.001f, num6 - num7);
    				float num9 = Mathf.Sin(num8 * (float)Math.PI);
    				float num10 = Mathf.Lerp(0.16f, 0.03f, num8);
    				float num11 = Mathf.Abs(num3 - num5 - 0.17f) / num10;
    				if (!(num11 > 1f))
    				{
    					float num12 = Mathf.Sqrt(Mathf.Max(0f, 1f - num11 * num11));
    					num4 = Mathf.Max(num4, num9 * num12);
    				}
    			}
    		}
    		return num4;
    	}

    	private static float Fbm(float x, float y, int octaves)
    	{
    		float num = 0f;
    		float num2 = 0.5f;
    		float num3 = 1f;
    		float num4 = 0f;
    		for (int i = 0; i < octaves; i++)
    		{
    			num += num2 * Value(x * num3, y * num3);
    			num4 += num2;
    			num2 *= 0.5f;
    			num3 *= 2f;
    		}
    		if (!(num4 > 0f))
    		{
    			return 0f;
    		}
    		return num / num4;
    	}

    	private static float Value(float x, float y)
    	{
    		int num = Mathf.FloorToInt(x);
    		int num2 = Mathf.FloorToInt(y);
    		float num3 = x - (float)num;
    		float num4 = y - (float)num2;
    		num3 = num3 * num3 * (3f - 2f * num3);
    		num4 = num4 * num4 * (3f - 2f * num4);
    		float num5 = Hash01(num, num2);
    		float num6 = Hash01(num + 1, num2);
    		float num7 = Hash01(num, num2 + 1);
    		float num8 = Hash01(num + 1, num2 + 1);
    		return Mathf.Lerp(Mathf.Lerp(num5, num6, num3), Mathf.Lerp(num7, num8, num3), num4);
    	}

    	private static float Hash01(int a, int b)
    	{
    		int num = (a * 73856093) ^ (b * 19349663);
    		int num2 = (num ^ (num >>> 13)) * 1540483477;
    		return (float)(uint)((num2 ^ (num2 >>> 15)) & 0xFFFFFF) / 16777215f;
    	}

    	private static void EnsureDir()
    	{
    		if (!AssetDatabase.IsValidFolder("Assets/Painterly/Generated/Ink"))
    		{
    			string text = Path.GetDirectoryName("Assets/Painterly/Generated/Ink").Replace('\\', '/');
    			string fileName = Path.GetFileName("Assets/Painterly/Generated/Ink");
    			AssetDatabase.CreateFolder(text, fileName);
    		}
    	}

    	private static void Finish(StringBuilder sb)
