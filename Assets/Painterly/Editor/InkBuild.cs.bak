    		stringBuilder.AppendLine("  " + ((num9 < 0.02f) ? "spread is below 0.02 — that is a flat fill, not an ink skin, and it will read as a silhouette with no surface" : ("spread " + num9.ToString("0.000") + " means the blotching and drips survived the write, so the surface will read as liquid")));
