    			{
    				Component val6 = val4.AddComponent(((object)val5).GetType());
    				EditorUtility.CopySerialized((Object)(object)val5, (Object)(object)val6);
    				val6.transform.localPosition = ((Component)val5).transform.localPosition;
    				val6.transform.localRotation = ((Component)val5).transform.localRotation;
    				val6.transform.localScale = ((Component)val5).transform.localScale;
    			}
    			sb.AppendLine("SleepingTree: reusing village prop '" + name + "'");
    		}
    		else
    		{
    			BuildStumpArt(sb, val.transform, val2);
    			sb.AppendLine("SleepingTree: PLACEHOLDER art from primitives, not a tree. Wants replacing with a real dead tree before it ships — but it is grey, it is paintable, and it makes the beat testable today.");
    		}
    		sleepingTree.Resolve();
    		string[] array = new string[9] { "SleepingTree: at ", null, null, null, null, null, null, null, null };
    		Vector3 touchPoint = sleepingTree.TouchPoint;
    		array[1] = touchPoint.ToString("F2");
    		array[2] = ", ";
    		array[3] = Vector3.Distance(Flat(sleepingTree.TouchPoint), Flat(monoPos)).ToString("0.00");
    		array[4] = " m from Mono, burst radius ";
    		array[5] = sleepingTree.BurstRadius.ToString("0.0");
    		array[6] = " m, touch distance ";
    		array[7] = sleepingTree.TouchDistance.ToString("0.0");
    		array[8] = " m";
    		sb.AppendLine(string.Concat(array));
    		return sleepingTree;
    	}

    	private static GameObject FindVillageTree(Vector3 near, out string name)
    	{
    		//IL_00f5: Unknown result type (might be due to invalid IL or missing references)
    		//IL_00fa: Unknown result type (might be due to invalid IL or missing references)
    		//IL_00ff: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0100: Unknown result type (might be due to invalid IL or missing references)
    		name = "";
    		GameObject val = null;
    		float num = float.MaxValue;
    		GameObject[] array = Object.FindObjectsByType<GameObject>();
    		foreach (GameObject val2 in array)
    		{
    			if (((Object)val2.transform.root).name == "L1_Cast" || ((Object)val2.transform.root).name == "L1_Beat3")
    			{
    				continue;
    			}
    			string text = ((Object)val2).name.ToLowerInvariant();
    			bool flag = false;
    			string[] treeWords = TreeWords;
    			foreach (string value in treeWords)
    			{
    				if (text.Contains(value))
    				{
    					flag = true;
    					break;
    				}
    			}
    			if (!flag)
    			{
    				continue;
    			}
    			bool flag2 = false;
    			treeWords = NotATree;
    			foreach (string value2 in treeWords)
    			{
    				if (text.Contains(value2))
    				{
    					flag2 = true;
    					break;
    				}
    			}
    			if (!flag2 && !((Object)(object)val2.GetComponentInChildren<Renderer>() == (Object)null))
    			{
    				float num2 = Vector3.Distance(Flat(val2.transform.position), Flat(near));
    				if (num2 < num)
    				{
    					num = num2;
    					val = val2;
    				}
    			}
    		}
    		if ((Object)(object)val != (Object)null)
    		{
    			name = ((Object)val).name;
    		}
    		return val;
    	}

