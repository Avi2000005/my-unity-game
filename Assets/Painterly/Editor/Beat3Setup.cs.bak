    public static class Beat3Setup
    {
    	private const string ContainerName = "L1_Beat3";

    	private const string LinesPath = "Assets/Painterly/MonoHintLines.asset";

    	private const string Report = "Temp/beat3_setup.txt";

    	private const float GullyMaxWidth = 6f;

    	private const float GullyMinWidth = 1.2f;

    	private const float MinWalkableWidth = 0.9f;

    	private static string _reason;

    	private static Vector3 _blockedAt;

    	private static readonly string[] TreeWords = new string[6] { "tree", "trunk", "stump", "log", "deadwood", "root" };

    	private static readonly string[] NotATree = new string[7] { "statue", "fountain", "debris", "chevron", "fragment", "rubble", "marker" };

    	private static readonly Collider[] OverlapBuffer = new Collider[8];

    	private const string StumpMatPath = "Assets/Painterly/Materials/Beat3_Stump.mat";

    	[MenuItem("Tools/Echoes/Build Beat 3 - Mono Awakens", priority = 70)]
    	public static void Run()
    	{
    		StringBuilder stringBuilder = new StringBuilder();
    		if (File.Exists(PathOf(Directory.GetCurrentDirectory(), "Temp/beat3_setup.txt")))
    		{
    			File.Delete(PathOf(Directory.GetCurrentDirectory(), "Temp/beat3_setup.txt"));
    		}
    		try
    		{
    			Body(stringBuilder);
    		}
    		catch (Exception ex)
    		{
    			stringBuilder.AppendLine();
    			stringBuilder.AppendLine("THREW: " + ex.GetType().Name + ": " + ex.Message);
    			stringBuilder.AppendLine(ex.StackTrace);
    			Debug.LogError((object)("[Echoes] Beat 3 setup threw: " + ex));
    		}
    		finally
    		{
    			Debug.Log((object)("[Echoes] Beat 3 setup\n" + stringBuilder));
    			File.WriteAllText(PathOf(Directory.GetCurrentDirectory(), "Temp/beat3_setup.txt"), stringBuilder.ToString());
    		}
    	}

    	private static void Body(StringBuilder sb)
    	{
    		//IL_0000: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0005: Unknown result type (might be due to invalid IL or missing references)
    		//IL_008c: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0091: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0099: Unknown result type (might be due to invalid IL or missing references)
    		//IL_009e: Unknown result type (might be due to invalid IL or missing references)
    		//IL_00e5: Unknown result type (might be due to invalid IL or missing references)
    		//IL_00e7: Unknown result type (might be due to invalid IL or missing references)
    		//IL_00ec: Unknown result type (might be due to invalid IL or missing references)
    		//IL_00ee: Unknown result type (might be due to invalid IL or missing references)
    		//IL_012f: Unknown result type (might be due to invalid IL or missing references)
    		//IL_016f: Unknown result type (might be due to invalid IL or missing references)
    		//IL_018f: Unknown result type (might be due to invalid IL or missing references)
    		//IL_0196: Unknown result type (might be due to invalid IL or missing references)
    		Scene activeScene = SceneManager.GetActiveScene();
    		if (!activeScene.isLoaded)
    		{
    			sb.AppendLine("No scene is open.");
    			return;
    		}
    		Physics.SyncTransforms();
    		GameObject val = GameObject.Find("Mono");
    		if ((Object)(object)val == (Object)null)
    		{
    			sb.AppendLine("NO Mono in the scene. Run Tools/Echoes/Place Level 1 Cast first — Beat 3 has nothing to attach to.");
    			return;
    		}
    		MonoCompanion monoCompanion = val.GetComponent<MonoCompanion>();
    		if ((Object)(object)monoCompanion == (Object)null)
    		{
    			monoCompanion = val.AddComponent<MonoCompanion>();
    			sb.AppendLine("added MonoCompanion to Mono — the cast tool places a body, the beat gives it a mind");
    		}
    		GameObject val2 = GameObject.Find("Ari");
    		if ((Object)(object)val2 == (Object)null)
    		{
    			sb.AppendLine("No Ari in the scene.");
    			return;
    		}
    		Vector3 position = val2.transform.position;
    		Vector3 position2 = val.transform.position;
    		sb.AppendLine("Ari  at " + position.ToString("F2"));
    		sb.AppendLine("Mono at " + position2.ToString("F2") + ", " + Vector3.Distance(Flat(position2), Flat(position)).ToString("0.0") + " m from her");
    		sb.AppendLine();
    		BuildLines(sb);
    		SleepingTree tree = BuildTree(sb, Container(sb), position2, monoCompanion);
    		GameObject orAdd = GetOrAdd("MonoChase", Container(sb));
    		MonoChase monoChase = orAdd.GetComponent<MonoChase>();
    		if ((Object)(object)monoChase == (Object)null)
    		{
    			monoChase = orAdd.AddComponent<MonoChase>();
    		}
    		BuildRoute(sb, orAdd.transform, position2);
    		Wire(sb, monoCompanion, val, tree, monoChase, val2);
    		Verify(sb, tree, monoChase, monoCompanion, val2);
    		EditorSceneManager.MarkSceneDirty(activeScene);
    		EditorSceneManager.SaveScene(activeScene);
    	}

    	private static MonoHintLines BuildLines(StringBuilder sb)
    	{
    		MonoHintLines monoHintLines = AssetDatabase.LoadAssetAtPath<MonoHintLines>("Assets/Painterly/MonoHintLines.asset");
    		bool flag = false;
    		if ((Object)(object)monoHintLines == (Object)null)
    		{
    			monoHintLines = ScriptableObject.CreateInstance<MonoHintLines>();
    			flag = true;
    		}
    		List<MonoHintLines.Line> l = new List<MonoHintLines.Line>();
    		Beat("beat3.wake", "Light. I felt it on the bark, and I thought I was dreaming again. Hello. I'm Mono. I'm not going to leave, if that's all right.");
    		Beat("beat3.thief", "Someone came through here and took all the colours out of the world. Every one of them. I remember that clearly. I do not remember their face.");
    		Beat("beat3.follow", "Keep going. The gully is longer than it looks, and it goes somewhere. It always goes somewhere. That is the good news.");
    		Beat("beat3.leg1", "You paint. I have never seen anyone paint before. I only remember the colour, not the doing of it.");
    		Beat("beat3.leg2", "Careful here. The stones are loose. I have been asleep a long time, but I remember this path by my knees.");
    		Beat("beat3.leg3", "There. Through. Was that hard? This part is not supposed to be hard. This part is always not hard.");
    		Beat("beat3.arrive", "This is as far as I go on my own for now. The rest is yours. I'll be right behind you. I always am.");
    		Rung(1, "The rim is marked. Those chevrons are the water's own way of running — every one of them points downhill.");
    		Rung(2, "Start at the top. The highest notch on the rim. From there the water could only ever go one way.");
    		Rung(3, "Highest notch, then follow the chevrons down, one at a time. Four notches. The fifth will disagree with the water — and that disagreement is your answer. It is the decoy.");
    		Ambient("amb.grey", "Everything here is grey. It wasn't always. I could tell you what colour it was, but I'd only be guessing, and I'd rather you looked.", 30f);
    		Ambient("amb.sky", "You could paint the sky, you know. I don't think anyone has tried the sky.", 55f);
    		Ambient("amb.quiet", "If you're tired, say so. I'll keep quiet. I'm very good at keeping quiet.", 70f);
    		Ambient("amb.fountain", "There's a fountain a little further on. It used to make a noise. I'd forgotten that noises could do that.", 45f);
    		monoHintLines.lines = l;
    		if (flag)
    		{
    			if (!Directory.Exists("Assets/Painterly"))
    			{
    				Directory.CreateDirectory("Assets/Painterly");
    			}
    			AssetDatabase.CreateAsset((Object)(object)monoHintLines, "Assets/Painterly/MonoHintLines.asset");
    		}
    		else
    		{
    			EditorUtility.SetDirty((Object)(object)monoHintLines);
    		}
    		monoHintLines.Tally(out var beat, out var rung, out var ambient, out var muted);
    		sb.AppendLine("Mono's lines: " + l.Count + " total — " + beat + " beat, " + rung + " hint rungs, " + ambient + " ambient" + ((muted > 0) ? (", " + muted + " muted") : "") + (flag ? " (new asset)" : ""));
    		sb.AppendLine("  at Assets/Painterly/MonoHintLines.asset");
    		sb.AppendLine("  beat ids: " + string.Join(", ", Ids(l, MonoHintLines.LineKind.Beat)));
    		return monoHintLines;
    		void Ambient(string id, string text, float gap = 25f)
    		{
    			l.Add(new MonoHintLines.Line
    			{
    				id = id,
    				text = text,
    				kind = MonoHintLines.LineKind.Ambient,
    				minGapSeconds = gap
    			});
    		}
    		void Beat(string id, string text, bool muted2 = false)
    		{
    			l.Add(new MonoHintLines.Line
    			{
    				id = id,
    				text = text,
    				kind = MonoHintLines.LineKind.Beat,
    				muted = muted2
    			});
    		}
    		void Rung(int n, string text)
    		{
    			l.Add(new MonoHintLines.Line
    			{
    				id = "beat6.rung" + n,
    				text = text,
    				rung = n,
    				kind = MonoHintLines.LineKind.HintRung
    			});
    		}
    	}

    	private static IEnumerable<string> Ids(List<MonoHintLines.Line> l, MonoHintLines.LineKind k)
    	{
    		foreach (MonoHintLines.Line item in l)
    		{
    			if (item.kind == k)
    			{
    				yield return item.id;
    			}
    		}
    	}

